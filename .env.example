# Optional model provider configuration. Set real credentials in your shell
# or IDE secret store; never put them in this file, .env, or committed files.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_FAST=
MODEL_STRONG=

# Optional reporting metadata. These are not credentials.
PROJECT_ID=
BASELINE_CURRENCY=

# Fetch domains are intentionally configured in .cursor/mcp.json and enforced
# by the Cursor hook. Do not broaden them through environment variables.
