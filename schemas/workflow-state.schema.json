{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/workflow-state.schema.json",
  "title": "Workflow checkpoint",
  "type": "object",
  "required": ["version", "project_id", "stage", "status", "next_action", "completed_actions", "input_hashes", "updated_at"],
  "properties": {
    "version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "integer", "minimum": 1, "maximum": 8 },
    "status": { "enum": ["in_progress", "paused", "blocked", "complete"] },
    "next_action": { "type": "string", "minLength": 1 },
    "completed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result", "input_hashes"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string" },
          "input_hashes": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "pending_human_approval": { "type": ["string", "null"] },
    "input_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
